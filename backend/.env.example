# Copy to .env and replace placeholders. Never commit .env.
# Local Docker PostgreSQL (docker compose up -d db)
DATABASE_URL=postgresql://deepcine:deepcine_dev@127.0.0.1:5433/deepcine
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173
ADMIN_TASK_TOKEN=

# Local development defaults. For Neon, set DB_POOL_MODE=null.
DB_POOL_MODE=queue
# Keep enabled locally; set false on a sleeping/free hosted API.
ENABLE_SCHEDULER=true
